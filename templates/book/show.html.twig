{% extends 'base.html.twig' %}

{% block title %}Book{% endblock %}

{% block body %}
    <div class="container my-5">
        <div class="row justify-content-center">
            <div class="col-md-8 p-4 border rounded shadow-sm bg-white">
                <h1 class="mb-4 text-center">Book Details</h1>

                <table class="table table-striped table-bordered">
                    <tbody>
                    <tr>
                        <th>Id</th>
                        <td>{{ book.id }}</td>
                    </tr>
                    <tr>
                        <th>Title</th>
                        <td>{{ book.title }}</td>
                    </tr>
                    <tr>
                        <th>Author</th>
                        <td>{{ book.author }}</td>
                    </tr>
                    <tr>
                        <th>Isbn</th>
                        <td>{{ book.isbn }}</td>
                    </tr>
                    </tbody>
                </table>

                <div class="d-flex justify-content-center gap-2 mt-3">
                    <a href="{{ path('app_book_index') }}" class="btn btn-secondary">← Back to list</a>
                    <a href="{{ path('app_book_edit', {'id': book.id}) }}" class="btn btn-primary">✏️ Edit</a>
                </div>

                <div class="mt-4 text-center">
                    {{ include('book/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
